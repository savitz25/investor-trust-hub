# InvestorTrustHub — environment template
# Copy to .env.local for the Next.js app and/or .env for local tooling.
# Never commit real secrets.

# ---------------------------------------------------------------------------
# Public site
# ---------------------------------------------------------------------------
# Canonical origin. On Vercel, a missing or localhost value falls back to
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL. Set this to the permanent
# public domain before enabling SITE_INDEXING_ENABLED.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=InvestorTrustHub

# ---------------------------------------------------------------------------
# Database (Postgres / Supabase-compatible)
# Server-only. Do not prefix with NEXT_PUBLIC_.
# Prefer a PostgreSQL Direct Connection (port 5432) for migrations and ingest.
# If db.<project-ref>.supabase.co does not resolve, use the session-mode
# pooler on port 5432 and set SUPABASE_POOLER_REGION.
# Always use sslmode=require for Supabase.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/investor_trust_hub
# DATABASE_URL=postgresql://postgres.<project-ref>:[password]@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_POOLER_REGION=us-east-2

# Optional Supabase project. Service role must stay server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Ingestion service (Python)
# Server-only. Least-privilege database role recommended.
# May match DATABASE_URL. Never expose this to the Next.js client bundle.
# ---------------------------------------------------------------------------
INGESTION_DATABASE_URL=postgresql://ith_ingest:change-me@localhost:5432/investor_trust_hub
INGESTION_ARCHIVE_DIR=./var/archive
INGESTION_STAGING_DIR=./var/staging

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# Gate A: site/domain may be indexed only when explicitly true.
# Missing or false keeps the entire deployment noindex, including eligible firms.
# Leave false until the permanent domain is attached and HTTPS/canonical QA passes.
SITE_INDEXING_ENABLED=false

# Gate B: comma-separated hostnames that may be indexed. Never include *.vercel.app.
# Example after domain attachment:
# INDEXABLE_HOSTS=www.example.com,example.com
# CANONICAL_HOST=www.example.com
INDEXABLE_HOSTS=
CANONICAL_HOST=
